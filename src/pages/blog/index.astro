---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout
  title="All Articles"
  description="Every SoloStack review, comparison, and tutorial on AI and automation tools for independent consultants."
>
  <h1>All articles</h1>
  {posts.map((post) => (
    <div class="post-list-item">
      <h2><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h2>
      <p class="meta">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
      <p>{post.data.description}</p>
    </div>
  ))}
</BaseLayout>
